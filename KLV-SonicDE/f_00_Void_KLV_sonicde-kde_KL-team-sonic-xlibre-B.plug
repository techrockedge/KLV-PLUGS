# f_00_Void_KLV_sonicde-kde_KL-team-sonic-xlibre-B.plug
# version="2.9"; revision="stable"
# Kennel Linux Void with SonicDE (KDE Plasma fork) and Xlibre
# Based on sonicde-meta v6.7 template
# Creation date 18Oct2026
# Revision date 22Oct2026
# Copyright Kennel Linux team; License MIT

# build this via terminal commands:build_firstrib_rootfs.sh
# ./build_firstrib_rootfs.sh void default amd64 f_00_Void_KLV_sonicde-kde_KL-team-sonic-xlibre-B.plug
# Using a symlink:
# ./bfr void default amd64 f_00_Void_KLV_sonicde-kde_KL-team-sonic-xlibre-B.plug
# build with output log:
# ./bfr void default amd64 f_00_Void_KLV_sonicde-kde_KL-team-sonic-xlibre-B.plug | tee build-kde-B.log

# Architecture x86_64

## --- STAGE 0: Security keys ---
mkdir -p /var/db/xbps/keys
wget -O /var/db/xbps/keys/00:ca:42:57:c9:c0:9a:ec:94:b4:7d:97:e5:a9:aa:1e.plist https://github.com/xlibre-void/xlibre/raw/refs/heads/main/repo-keys/x86_64/00:ca:42:57:c9:c0:9a:ec:94:b4:7d:97:e5:a9:aa:1e.plist
wget -O /var/db/xbps/keys/75:89:db:c3:95:d3:2c:c5:b0:31:b7:f0:2f:eb:3b:7f.plist https://github.com/techrockedge/void-package/raw/refs/heads/main/repo-keys/x86_64/75:89:db:c3:95:d3:2c:c5:b0:31:b7:f0:2f:eb:3b:7f.plist
wget -O /var/db/xbps/keys/0c:88:e8:39:e6:e5:4c:0c:9f:7b:0f:ac:eb:68:16:c0.plist https://github.com/sonicde-void/sonicde-void/raw/refs/heads/master/common/repo-keys/0c:88:e8:39:e6:e5:4c:0c:9f:7b:0f:ac:eb:68:16:c0.plist

echo "Got the keys....."

## --- STAGE 1: Repositories and Base System ---
xbps-install -y base-minimal ncurses-base bash eudev
xbps-install -y file mc xterm xauth dbus-glib eudev kmod
xbps-install -y shadow dhcpcd wpa_supplicant
xbps-install -y ntfs-3g zstd xz zip unzip p7zip rsync
xbps-install -y binutils xz device-mapper dhclient dracut-network openresolv
xbps-install -y openssl dialog sed elogind polkit

# Add custom repositories
cat <<'SETMIRROR' > /etc/xbps.d/99-repository-xlibre.conf
repository=https://github.com/xlibre-void/xlibre/releases/latest/download
SETMIRROR

cat <<'SETMIRROR' > /etc/xbps.d/techrockedge-void-repository.conf
repository=https://github.com/techrockedge/void-package/releases/latest/download
SETMIRROR

# add sonicde-void github SonicDE repository
cat <<'SETMIRROR' > /etc/xbps.d/sonicde-void-repository.conf
repository=https://github.com/sonicde-void/sonicde-void/releases/latest/download
SETMIRROR

## Update repos
# xbps-install -Suy xbps

echo "Updating the all of the repos....."
xbps-install -Sy

echo "Ready to install XLibre....."
xbps-install -y xlibre

## --- STAGE 2: System Core and Users ---
pwconv
grpconv
printf "root\nroot\n" | passwd >/dev/null 2>&1
usermod --shell /bin/bash root

sed -i 's/#en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/default/libc-locales
xbps-reconfigure -f glibc-locales
echo "LANG=en_US.UTF-8" >> /etc/environment

xbps-install -y sudo
echo '%wheel ALL=(ALL) NOPASSWD: ALL' | (VISUAL="tee -a" visudo)
useradd -m -G wheel,audio,video -s /bin/bash weedog
printf "weedog\nweedog\n" | passwd weedog >/dev/null 2>&1
useradd -m -G wheel,audio,video -s /bin/bash spot
printf "spot\nspot\n" | passwd spot >/dev/null 2>&1

## --- STAGE 3: SonicDE (KDE Plasma) ---
# Install the KDE fork meta-package
xbps-install -y sonicde-meta sonic-login-manager 

## Install packages
xbps-install -y rox-filer2
xbps-install -y yad udisks2 breeze-icons
xbps-install -y acpi lua fox xdotool lm_sensors
xbps-install -y noto-fonts-ttf gtk-layer-shell gsimplecal-gtk3

# Optional packages
#
xbps-install -y geany gftp ffmpeg mtpaint dolphin konsole void-artwork
xbps-install -y octoxbps guvcview putty epdfview
xbps-install -y e2fsprogs yelp gparted viewnior pfetch
xbps-install -y dosfstools mtools galculator
xbps-install -y squashfs-tools wget leafpad xorriso
xbps-install -y btop gpick gcolor2 gufw mpv htop
xbps-install -y brightnessctl gettext cups
xbps-install -y python3 python3-dbus python3-gobject x11-utils x11-xkb-utils dbus

# Install Xorg components for SonicDE <JWM>

xbps-install -y xinit xmessage xprop xcompmgr
xbps-install -y xdg-utils gxmessage arandr xset
xbps-install -y xlockmore xtools xmodmap xrdb xrandr

# Install Network Manager
#
xbps-install -y NetworkManager network-manager-applet
ln -s /etc/sv/NetworkManager /etc/runit/runsvdir/default/NetworkManager

# Install and configure SDDM (instead of sonic-login-manager)
xbps-install -y sddm
# ln -s /etc/sv/sddm /var/service/
ln -s /etc/sv/sddm /etc/runit/runsvdir/default/sddm

# Force the SDDM theme from the sonicde-meta dependencies
mkdir -p /etc/sddm.conf.d
cat <<'EOF' > /etc/sddm.conf.d/sonic-theme.conf
[Theme]
Current=Sonic-Silver-Light
EOF

## --- STAGE 4: Audio (PipeWire) ---
# Install packages. sonicde-meta pulls in sonic-pipewire, but we install the base explicitly
xbps-install -y pipewire wireplumber alsa-utils bluez bluez-obex bluez-deprecated libspa-bluetooth

# --- Autostart via XDG (standard method for SonicDE/KDE) ---
# Copy the global .desktop files to the autostart directory
cp /usr/share/applications/pipewire.desktop /etc/xdg/autostart/
# cp /usr/share/applications/pipewire-pulse.desktop /etc/xdg/autostart/

# Wireplumber (session manager) must also be autostarted
if [ -f /usr/share/applications/wireplumber.desktop ]; then
 cp /usr/share/applications/wireplumber.desktop /etc/xdg/autostart/
fi

mkdir -p /etc/pipewire/pipewire.conf.d
ln -s /usr/share/examples/wireplumber/10-wireplumber.conf /etc/pipewire/pipewire.conf.d/
ln -s /usr/share/examples/pipewire/20-pipewire-pulse.conf /etc/pipewire/pipewire.conf.d/

mkdir -p /etc/alsa/conf.d
ln -s /usr/share/alsa/alsa.conf.d/50-pipewire.conf /etc/alsa/conf.d
ln -s /usr/share/alsa/alsa.conf.d/99-pipewire-default.conf /etc/alsa/conf.d

# --- Disable native PulseAudio (required!) ---
# In KDE Plasma the pulseaudio service may start separately. We only want pipewire-pulse.
if [ -f /etc/xdg/autostart/pulseaudio.desktop ]; then
  mv /etc/xdg/autostart/pulseaudio.desktop /etc/xdg/autostart/pulseaudio.desktop.bak
fi

# Disable autospawn in the client configuration,
# so applications don't try to launch the old pulseaudio, bypassing pipewire
if [ -f /etc/pulse/client.conf ]; then
  sed -i 's/; autospawn = yes/autospawn = no/' /etc/pulse/client.conf
fi

# --- Per-user configuration ---
#setup_pipewire_user() {
#  local user_home="$1"
#  mkdir -p "${user_home}/.config/pipewire/pipewire.conf.d"
  # Copy example configurations for correct ALSA and Bluetooth operation
#  [ -f /usr/share/examples/wireplumber/10-wireplumber.conf ] && ln -sf /usr/share/examples/wireplumber/10-wireplumber.conf "${user_home}/.config/pipewire/pipewire.conf.d/"
#  [ -f /usr/share/examples/pipewire/20-pipewire-pulse.conf ] && ln -sf /usr/share/examples/pipewire/20-pipewire-pulse.conf "${user_home}/.config/pipewire/pipewire.conf.d/"
#}

setup_pipewire_user /root
setup_pipewire_user /home/spot
setup_pipewire_user /home/weedog

# octoxbps-notifier
cp /usr/share/applications/octoxbps-notifier.desktop /etc/xdg/autostart/

## --- STAGE 5: User Environments ---
# Create standard directories
for user in root spot weedog; do
  home_dir="/home/$user"
  [ "$user" = "root" ] && home_dir="/root"

  mkdir -p "$home_dir/Desktop" "$home_dir/Documents" "$home_dir/Downloads" "$home_dir/Music" "$home_dir/Pictures" "$home_dir/Videos" "$home_dir/Templates" "$home_dir/Public" "$home_dir/Startup"

  # Application autostart in KDE (XDG compatible)
  mkdir -p "$home_dir/.config/autostart"

  # CPU temp monitor (kept as a useful tool)
  cat <<'EOF' > "$home_dir/.config/autostart/poorercputemp.desktop"
[Desktop Entry]
Encoding=UTF-8
Type=Application
NoDisplay=true
Name=poorercputemp
Exec=sudo poorercputemp
EOF
done

# .Xresources for xterm (in case it is run without the KDE terminal)
cat <<'XRESOURCES' > /root/.Xresources
XTerm*faceName: Monospace; Xft*antialias: true; XTerm*faceSize: 9; XTerm.vt100.geometry: 95x25
XRESOURCES
cp /root/.Xresources /home/spot/
cp /root/.Xresources /home/weedog/

# Bash prompt
fancy_prompt='PS1="\[\e[0;36m\]┌──\[\e[0m\][ \[\e[0;33m\]\u\[\e[0m\]\[\e[0;32m\]@\[\e[0;36m\]\h\[\e[0m\] ] [ \[\e[0;36m\]\t\[\e[0m\] ]\n\[\e[0;36m\]├── \[\e[0;32m\]\w\[\e[0;36m\]\n\[\e[0;36m\]└>\[\e[0m\]"'
for file in /root/.bashrc /home/spot/.bashrc /home/weedog/.bashrc; do
  touch "$file"
  sed -i "/PS1/d" "$file"
  echo "$fancy_prompt" >> "$file"
done

# OctoXBPS for root (run as spot)
mkdir -p /root/.local/share/applications
cp /usr/share/applications/octoxbps*.desktop /root/.local/share/applications/ 2>/dev/null || true
sed -i 's|^Exec=|Exec=run-as-spot |' /root/.local/share/applications/octoxbps*.desktop 2>/dev/null || true

## --- STAGE 6: Services ---
ln -s /etc/sv/dbus /etc/runit/runsvdir/default/
ln -s /etc/sv/elogind /etc/runit/runsvdir/default/
ln -s /etc/sv/NetworkManager /etc/runit/runsvdir/default/
ln -s /etc/sv/cupsd /etc/runit/runsvdir/default/
ln -s /etc/sv/ufw /etc/runit/runsvdir/default/
# ln -s /etc/sv/bluetoothd /etc/runit/runsvdir/default/

# Add users to groups
usermod -a -G bluetooth -a root
usermod -a -G bluetooth -a spot
usermod -a -G bluetooth -a weedog

## --- STAGE 7: KLV Custom Packages ---
#### Get KLV custom packages ####
#
# Create and switch to build directory

mkdir -p /root/Build
cd /root/Build

wget -c https://github.com/techrockedge/xbps_packages/raw/refs/heads/main/gparted-shell-1.0_0.noarch.xbps
wget -c https://github.com/techrockedge/xbps_packages/raw/refs/heads/main/mime-add-1.1_0.noarch.xbps
wget -c https://github.com/techrockedge/xbps_packages/raw/refs/heads/main/xbps-tools-1.0_3.noarch.xbps
wget -c https://github.com/techrockedge/xbps_packages/raw/refs/heads/main/howbig-1.0_1.noarch.xbps
wget -c https://github.com/techrockedge/xbps_packages/raw/refs/heads/main/tzupdate2-2.0_2.noarch.xbps
wget -c https://github.com/techrockedge/xbps_packages/raw/refs/heads/main/SFS-Load-2.0_1.noarch.xbps
wget -c https://github.com/techrockedge/xbps_packages/raw/refs/heads/main/tas-2.0_1.noarch.xbps
wget -c https://github.com/techrockedge/xbps_packages/raw/refs/heads/main/YRadio-1.9_1.x86_64.xbps
wget -c https://github.com/techrockedge/xbps_packages/raw/refs/heads/main/gettext-xdeb-2.0_1.noarch.xbps
wget -c https://github.com/techrockedge/xbps_packages/raw/refs/heads/main/run-as-users-1.5_1.noarch.xbps
wget -c https://github.com/techrockedge/xbps_packages/raw/refs/heads/main/swapper-1.2_1.noarch.xbps
# wget -c https://github.com/techrockedge/xbps_packages/raw/refs/heads/main/packit-pfind-uextract-4.0_1.x86_64.xbps
wget -c https://github.com/techrockedge/xbps_packages/raw/refs/heads/main/set_hostname-1.0_1.noarch.xbps
wget -c https://github.com/techrockedge/xbps_packages/raw/refs/heads/main/save2flash-1.9_0.noarch.xbps
wget -c https://github.com/techrockedge/xbps_packages/raw/refs/heads/main/poorercputemp-0.2_1.x86_64.xbps
wget -c https://github.com/techrockedge/xbps_packages/raw/refs/heads/main/runkit-1.4.0_1.x86_64.xbps
wget -c https://github.com/techrockedge/xbps_packages/raw/refs/heads/main/psync-2.9_2.x86_64.xbps
wget -c https://github.com/techrockedge/xbps_packages/raw/refs/heads/main/sysinfo-3.0_1.noarch.xbps
wget -c https://github.com/techrockedge/xbps_packages/raw/refs/heads/main/tool-apps-3.0_1.noarch.xbps

wget -c https://github.com/techrockedge/xbps_packages/raw/refs/heads/main/packit-1.25_1.noarch.xbps
wget -c https://github.com/techrockedge/xbps_packages/raw/refs/heads/main/uextract-4.18_1.x86_64.xbps

# wget -c https://github.com/techrockedge/xbps_packages/raw/refs/heads/main/jwmrc_config-C-1.9_1.noarch.xbps
# wget -c https://github.com/techrockedge/xbps_packages/raw/refs/heads/main/mjwm-5.1.0_1.noarch.xbps

# Spectrwm components
# wget -c https://github.com/techrockedge/xbps_packages/raw/refs/heads/main/Spectrwm-xlibre-bar-config-4.2_1.noarch.xbps
# wget -c https://github.com/techrockedge/xbps_packages/raw/refs/heads/main/backgrounds-spectrwm-2.0_1.noarch.xbps
# wget -c https://github.com/techrockedge/xbps_packages/raw/refs/heads/main/spectrwm-icons-1.0_3.noarch.xbps
# wget -c https://github.com/techrockedge/xbps_packages/raw/refs/heads/main/spectrwm-themes-1.0_4.noarch.xbps
# wget -c https://github.com/techrockedge/xbps_packages/raw/refs/heads/main/Touchpad-spectrwm-2.1_1.noarch.xbps
# wget -c https://github.com/techrockedge/xbps_packages/raw/refs/heads/main/spectrwm-dcontrol-2.0_1.noarch.xbps


#### Install KLV custom packages ####

# Register and index packages
cd /root
xbps-rindex -a Build/*.xbps

# Install runkit
xbps-install -y --repository=Build/ runkit-1.4.0_1

# Install gparted-shell
xbps-install -y --repository=Build/ gparted-shell-1.0_0

# Install MIME definitions
xbps-install -y --repository=Build/ mime-add-1.1_0

# Install howbig
xbps-install -y --repository=Build/ howbig-1.0_1

# Install xbps-tools
xbps-install -y --repository=Build/ xbps-tools-1.0_3

# Install tzupdate
xbps-install -y --repository=Build/ tzupdate2-2.0_2

# Install SFS-Load
xbps-install -y --repository=Build/ SFS-Load-2.0_1

# Install tas
xbps-install -y --repository=Build/ tas-2.0_1

# Install gettext stub and xdeb
xbps-install -y --repository=Build/ gettext-xdeb-2.0_1

# Install gettext
# xbps-install -y --repository=Build/ gettext-1.0_1

# Install swapper
xbps-install -y --repository=Build/ swapper-1.2_1

# Install run-as-spot and run-as-weedog
xbps-install -y --repository=Build/ run-as-users-1.5_1

# Install save2flash RAM2 mechanism
xbps-install -y --repository=Build/ save2flash-1.9_0

# Install packit-pfind-uextract
# xbps-install -y --repository=Build/ packit-pfind-uextract-4.0_1

# Install script to edit system hostname
xbps-install -y --repository=Build/ set_hostname-1.0_1

# Install poorercputemp
xbps-install -y --repository=Build/ poorercputemp-0.2_1

# Install Spectrwm-xlibre-bar-config
# xbps-install -y --repository=Build/ Spectrwm-xlibre-bar-config-4.2_1

# Install backgrounds-spectrwm-2.0_1
# xbps-install -y --repository=Build/ backgrounds-spectrwm-2.0_1

# Install psync
xbps-install -y --repository=Build/ psync-2.9_2

# Install sysinfo
xbps-install -y --repository=Build/ sysinfo-3.0_1

# Install tool-apps
xbps-install -y --repository=Build/ tool-apps-3.0_1

# Install YRadio
xbps-install -y --repository=Build/ YRadio-1.9_1

# Install packit
xbps-install -y --repository=Build/ packit-1.25_1

# Install UExtract
xbps-install -y --repository=Build/ uextract-4.18_1

# Install mjwm
# xbps-install -y --repository=Build/ mjwm-5.1.0_1

# Install jwmrc_config
# xbps-install -y --repository=Build/ jwmrc_config-C-1.9_1


# Set execution permissions recursivly for binaries and scripts
chmod +x -R /usr/local/bin
echo "custom packages are installed."
echo "stage 2 is complete!!"
## --- STAGE 8: Finalization ---
chown -R spot:spot /home/spot
chown -R weedog:weedog /home/weedog
xhost +local:root > /dev/null

ln -sf /usr/share/zoneinfo/America/New_York /etc/localtime

# Cleanup
rm -r /root/Build
rm -rf /var/cache/xbps/* /var/db/xbps/partial/*

echo "KLV SonicDE (KDE Plasma) build finished."

